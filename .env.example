# Переменные окружения сервиса (service/config.py). Скопируйте в .env и
# заполните для локального запуска вне docker-compose (uvicorn читает .env
# сам не будет -- передайте через `export $(cat .env | xargs)` или
# `docker compose --env-file .env ...`); при запуске через docker-compose.yml
# переменные можно задать прямо в окружении хоста или в `environment:` сервиса.
#
# .env в .gitignore -- никогда не коммитьте реальные секреты.

# dev (по умолчанию) | production.
# В production сервис при старте ОБЯЗАТЕЛЬНО требует DS_API_KEY и наличие
# предобученной модели L4 на диске (DS_MODEL_PATH) -- иначе не поднимется,
# вместо того чтобы молча обслуживать трафик синтетической моделью без ключа.
DS_ENV=dev

# Ключ для заголовка X-API-Key (или ?api_key= для SSE-подключений из браузера).
# Не задан -- API открыт (годится только для dev/локального прототипа).
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DS_API_KEY=

# Через запятую. По умолчанию (если не задано) -- localhost:5173 (Vite dev-сервер).
# DS_CORS_ORIGINS=https://example.com,https://app.example.com

# Путь к сохранённой на диск модели L4 (относительно рабочей директории
# процесса). По умолчанию build/models/l4_gradient_boosting.joblib -- см.
# docker-compose.yml, том ./build:/app/build для сервиса app.
# DS_MODEL_PATH=build/models/l4_gradient_boosting.joblib

# DEBUG | INFO | WARNING | ERROR
DS_LOG_LEVEL=INFO
